{% extends 'base.html.twig' %}

{% block title %}{{ pokemon.name }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="card mx-auto text-dark" style="max-width: 22rem;">
            <img src="{{ asset('images/' ~ pokemon.image) }}" class="card-img-top" alt="{{ pokemon.name }} kaart">
            <div class="card-body">
                <h1 class="card-title h3">{{ pokemon.name }}</h1>
                <p class="card-text">{{ pokemon.description ?: 'Geen beschrijving beschikbaar.' }}</p>
                <p class="card-text fw-bold">&euro;{{ pokemon.cardValue|number_format(2, ',', '.') }}</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a href="{{ path('app_pokemon') }}" class="btn btn-info">Terug naar overzicht</a>
                    <a href="{{ path('app_pokemon_edit', {id: pokemon.id}) }}" class="btn btn-secondary">Bewerken</a>
                    <a href="{{ path('app_pokemon_delete_confirm', {id: pokemon.id}) }}" class="btn btn-danger">Verwijderen</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
