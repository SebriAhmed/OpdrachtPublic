{% extends 'base.html.twig' %}

{% block title %}Pokemon kaarten overzicht{% endblock %}

{% block body %}
    <h1>Pokemon kaarten</h1>

    <div class="container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}

        <div class="text-end mb-4">
            <a href="{{ path('app_pokemon_new') }}" class="btn btn-info">Voeg een kaart toe</a>
        </div>

        <div class="row">
            {% for pokemon in pokemons %}
                <div class="col-md-4 d-flex align-items-stretch">
                    <div class="card flex-grow-1">
                        <img src="{{ asset('images/' ~ pokemon.image) }}" class="card-img-top object-fit-cover" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">{{ pokemon.name }}</h5>
                            <p class="card-text">&euro;{{ pokemon.cardValue|number_format(2, ',', '.') }}</p>
                        </div>
                        <div class="d-flex gap-2 justify-content-center p-3 pt-0">
                            <a href="{{ path('app_pokemon_show', {id: pokemon.id}) }}" class="btn btn-info">Meer info</a>
                            <a href="{{ path('app_pokemon_edit', {id: pokemon.id}) }}" class="btn btn-secondary">Bewerken</a>
                            <a href="{{ path('app_pokemon_delete_confirm', {id: pokemon.id}) }}" class="btn btn-danger">Verwijderen</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
